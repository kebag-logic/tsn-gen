 	PROPERTIES ENVIRONMENT "UBSAN_OPTIONS=halt_on_error=1"
 )
+
+# R231 mutation M7: faulting modes judged by the clean controls' policy.
+foreach(_case sanitizer_probe-test_ASAN:library-heap-overflow
